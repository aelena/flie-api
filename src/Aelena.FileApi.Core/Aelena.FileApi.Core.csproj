<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Aelena.FileApi.Core</RootNamespace>
    <PackageId>Aelena.FileApi.Core</PackageId>
    <Version>0.3.0</Version>
    <Authors>aelena</Authors>
    <Description>Pure document processing library — PDF, DOCX, image, email, hash, PII, readability, and more. Zero ASP.NET dependencies. Use standalone or behind any host (API, CLI, gRPC).</Description>
    <PackageTags>document;pdf;docx;image;ocr;hash;pii;readability</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/aelena/fileapi</RepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Auth (JWT) -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />

    <!-- Token counting -->
    <PackageReference Include="SharpToken" />

    <!-- SQLite persistence -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />

    <!-- Templating -->
    <PackageReference Include="Scriban" />

    <!-- PDF -->
    <PackageReference Include="itext7" />
    <PackageReference Include="itext7.bouncy-castle-adapter" />

    <!-- DOCX / Office -->
    <PackageReference Include="DocumentFormat.OpenXml" />

    <!-- Email -->
    <PackageReference Include="MimeKit" />

    <!-- Image -->
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
  </ItemGroup>

</Project>
