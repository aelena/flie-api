<Project>

  <!--
    Imported after each csproj body, so $(IsTestProject) is already set here.
    The same conditions in Directory.Build.props would evaluate before the
    project declares it, and silently do nothing.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      CA1707: xUnit's Method_Scenario_Expectation convention is deliberate and
              reads better than the PascalCase the rule asks for.
      CA1861: a constant array inline in test arrangement is clearer than a
              hoisted static field.
      CA1711: xUnit collection-definition markers conventionally end in
              'Collection'; the rule is about public API surface, which a test
              marker class is not.
      All three stay enforced in src/.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA1711</NoWarn>
  </PropertyGroup>

  <!--
    IDE0005 (unnecessary using) is enforced on the LTS target only. The set of
    implicit usings differs between target frameworks — System.Net.Http.Json is
    implicit on net11.0 but not net10.0 — so a using that is required by one
    target is redundant in the other, and no single source file can satisfy both.
    Enforcing it on net10.0 still catches genuinely dead usings.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>

</Project>
