<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Aelena.FileApi.Grpc</RootNamespace>
    <PackageId>Aelena.FileApi.Grpc</PackageId>
    <Version>0.1.0</Version>
    <Authors>aelena</Authors>
    <Description>gRPC service for high-performance document processing — binary streaming and compute-heavy operations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Aelena.FileApi.Core\Aelena.FileApi.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Aelena.FileApi.Core.Pdf\Aelena.FileApi.Core.Pdf.csproj" Condition="'$(IncludePdf)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!--
      "Both" so the client stub is generated here alongside the server base.
      The test project used to generate its own from the same .proto while also
      referencing this one, producing two definitions of every message type and
      630 CS0436 conflict warnings that TreatWarningsAsErrors had to be switched
      off to tolerate.
    -->
    <Protobuf Include="Protos\fileapi.proto" GrpcServices="Both" />
  </ItemGroup>


  <!-- Dropped by -p:IncludePdf=false; see Directory.Build.props. -->
  <ItemGroup Condition="'$(IncludePdf)' != 'true'">
    <Compile Remove="Services\FileGrpcService.Pdf.cs" />
  </ItemGroup>

</Project>
